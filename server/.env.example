JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:5173
PORT=4000
# Email provider not yet chosen: in development, verification and reset links are printed to the server log.
MAIL_FROM=Insight <no-reply@example.com>
# Server-side only, used from milestone 2:
